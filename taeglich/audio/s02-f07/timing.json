   "typ": "gesicht",
   "kapitel": 1,
   "start": 7.07,
   "dauer": 4.646,
   "emotion": "ernst",
   "text": "Ben ruft an. „Mia fährt weg. Ein halbes Jahr. Kein Witz.“"
  },
  {
   "nr": 3,
   "typ": "gesicht",
   "kapitel": 1,
   "start": 11.716,
   "dauer": 4.526,
   "emotion": "spannend",
   "text": "Ein halbes Jahr. Und sie hat dir nichts gesagt. Genau wie du ihr."
