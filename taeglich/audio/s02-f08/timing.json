{
 "dauer": 72.996,
 "einstellungen": [
  {
   "nr": 1,
   "typ": "bahnhof",
   "kapitel": 1,
   "start": 0.0,
   "dauer": 4.094,
   "emotion": "erzaehlend",
   "text": "Deine beste Freundin hat ihren Zug sausen lassen. Für dich."
  },
  {
   "nr": 2,
   "typ": "gesicht",
   "kapitel": 1,
   "start": 4.094,
   "dauer": 2.846,
   "emotion": "ernst",
   "text": "„Das Geld ist mir egal. Die Lüge nicht.“"
  },
  {
   "nr": 3,
   "typ": "gesicht",
   "kapitel": 1,
   "start": 6.94,
   "dauer": 2.966,
   "emotion": "traurig",
   "text": "„Ich weiß. Ich hatte Angst, dass sich alles ändert.“"
  },
  {
   "nr": 4,
   "typ": "grossstadt",
   "kapitel": 1,
   "start": 9.906,
   "dauer": 4.862,
   "emotion": "erzaehlend",
   "text": "Ihr lauft zu Fuß nach Hause. Mia zieht ihren Koffer, du trägst ihre Tasche."
  },
  {
   "nr": 5,
   "typ": "gesicht",
   "kapitel": 2,
   "start": 14.768,
   "dauer": 3.35,
   "emotion": "froh",
   "text": "„Hat es ja auch. Du bist ein schlechter Lügner geworden.“"
  },
  {
   "nr": 6,
   "typ": "see",
   "kapitel": 2,
   "start": 18.118,
   "dauer": 4.91,
   "emotion": "erzaehlend",
   "text": "Am See lässt sie einen Stein springen. Fünfmal. Deiner geht wieder unter."
  },
  {
   "nr": 7,
   "typ": "esstisch",
   "kapitel": 3,
   "start": 23.028,
   "dauer": 7.862,
   "emotion": "erzaehlend",
   "text": "Sonntag. Opas Geburtstag. Er sitzt mit Krücken am Kopfende. Und zum ersten Mal seit acht Monaten ist jeder Stuhl besetzt."
  },
  {
   "nr": 8,
   "typ": "gesicht",
   "kapitel": 3,
   "start": 30.89,
   "dauer": 4.118,
   "emotion": "ernst",
   "text": "Du stehst auf. Dein Herz klopft lauter als bei der Lottozentrale."
  },
  {
   "nr": 9,
   "typ": "objekt",
   "kapitel": 3,
   "start": 35.008,
   "dauer": 3.134,
   "emotion": "erklaerend",
   "text": "„Opa hat gewonnen. Mit euren Geburtstagen.“"
  },
  {
   "nr": 10,
   "typ": "gesicht",
   "kapitel": 3,
   "start": 38.142,
   "dauer": 3.47,
   "emotion": "spannend",
   "text": "Papa lässt die Gabel fallen. Oma verschluckt sich am Kuchen."
  },
  {
   "nr": 11,
   "typ": "gesicht",
   "kapitel": 3,
   "start": 41.612,
   "dauer": 1.478,
   "emotion": "froh",
   "text": "„Krieg ich jetzt ein Pferd?“"
  },
  {
   "nr": 12,
   "typ": "gesicht",
   "kapitel": 3,
   "start": 43.09,
   "dauer": 2.918,
   "emotion": "froh",
   "text": "Opa sagt gar nichts. Er zwinkert dir nur zu."
  },
  {
   "nr": 13,
   "typ": "esstisch",
   "kapitel": 4,
   "start": 46.008,
   "dauer": 5.222,
   "emotion": "froh",
   "text": "Ihr teilt es. Für uns alle, wie auf dem Schein. Und Opa will nur eins dafür."
  },
  {
   "nr": 14,
   "typ": "gesicht",
   "kapitel": 4,
   "start": 51.23,
   "dauer": 4.19,
   "emotion": "froh",
   "text": "„Jeden Sonntag. Hier. Alle. Ohne Ausrede.“"
  },
  {
   "nr": 15,
   "typ": "gesicht",
   "kapitel": 4,
   "start": 55.42,
   "dauer": 1.67,
   "emotion": "froh",
   "text": "Der beste Deal deines Lebens."
  },
  {
   "nr": 16,
   "typ": "lebenszeit",
   "kapitel": 4,
   "start": 57.09,
   "dauer": 5.462,
   "emotion": "erzaehlend",
   "text": "Wenn alles gut geht, sind das noch ein paar Hundert Sonntage. Jeder einzelne mehr wert als der Gewinn."
  },
  {
   "nr": 17,
   "typ": "polarlicht",
   "kapitel": 5,
   "start": 62.552,
   "dauer": 3.686,
   "emotion": "erzaehlend",
   "text": "Später stehst du mit Mia am Fenster. Die Stadt leuchtet."
  },
  {
   "nr": 18,
   "typ": "kiosk",
   "kapitel": 5,
   "start": 66.238,
   "dauer": 6.758,
   "emotion": "froh",
   "text": "Und am Samstag humpelt Opa zum Kiosk. Dieselben Zahlen. Wie immer. Weil er nie gespielt hat, um zu gewinnen."
  }
 ]
}