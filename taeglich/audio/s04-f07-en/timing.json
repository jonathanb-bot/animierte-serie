  {
   "nr": 5,
   "typ": "gesicht",
   "kapitel": 2,
   "start": 14.528,
   "dauer": 1.91,
   "emotion": "ernst",
   "text": "“I'll keep asking until it's true.”"
  },
  {
   "nr": 6,
   "typ": "gesicht",
   "kapitel": 2,
   "start": 16.438,
   "dauer": 1.91,
   "emotion": "wuetend",
   "text": "Sami is all out of jokes."
