  {
   "nr": 3,
   "typ": "fundhaus",
   "kapitel": 2,
   "start": 7.324,
   "dauer": 3.686,
   "emotion": "erzaehlend",
   "text": "Five thirty. Outside, rain drums on the awning."
  },
  {
   "nr": 4,
   "typ": "fundhaus",
   "kapitel": 2,
   "start": 11.01,
   "dauer": 3.518,
   "emotion": "erzaehlend",
   "text": "For the third time, Rike asks Sami where he was."
