   "nr": 13,
   "typ": "objekt",
   "kapitel": 3,
   "start": 37.032,
   "dauer": 3.662,
   "emotion": "erklaerend",
   "text": "You slide Jonas's watch across the counter. It's still ticking."
  },
  {
   "nr": 14,
   "typ": "gesicht",
   "kapitel": 3,
   "start": 40.694,
   "dauer": 2.75,
   "emotion": "traurig",
   "text": "“This is yours. The papers stay here.”"
  },
  {
   "nr": 15,
   "typ": "fundhaus",
   "kapitel": 4,
   "start": 43.444,
   "dauer": 3.758,
   "emotion": "erzaehlend",
   "text": "For a long time, nothing. Just rain and ticking."
  },
  {
   "nr": 16,
   "typ": "gesicht",
   "kapitel": 4,
   "start": 47.202,
   "dauer": 3.302,
   "emotion": "traurig",
   "text": "Then he puts the receipts down. And takes only the watch."
  },
  {
   "nr": 17,
   "typ": "haltestelle",
   "kapitel": 4,
   "start": 50.504,
   "dauer": 4.022,
   "emotion": "erzaehlend",
   "text": "He leaves without an umbrella. His green jacket darkens in the rain."
  },
  {
   "nr": 18,
   "typ": "gesicht",
   "kapitel": 4,
   "start": 54.526,
   "dauer": 2.846,
   "emotion": "traurig",
   "text": "Your sleeves are wet. You didn't even say goodbye."
