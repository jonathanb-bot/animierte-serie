  {
   "nr": 21,
   "typ": "fundhaus",
   "kapitel": 4,
   "start": 63.352,
   "dauer": 3.566,
   "emotion": "erzaehlend",
   "text": "Inside, it smells like soap. Next to you is an empty chair."
