  {
   "nr": 8,
   "typ": "gesicht",
   "kapitel": 3,
   "start": 20.498,
   "dauer": 2.726,
   "emotion": "traurig",
   "text": "“No paper, nothing left to interrogate.”"
  },
  {
   "nr": 9,
   "typ": "gesicht",
   "kapitel": 3,
   "start": 23.224,
   "dauer": 2.75,
   "emotion": "spannend",
   "text": "He'll tear them up. Even the one that could save him."
