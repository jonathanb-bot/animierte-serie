{
 "dauer": 79.412,
 "einstellungen": [
  {
   "nr": 1,
   "typ": "fundhaus",
   "kapitel": 1,
   "start": 0.0,
   "dauer": 4.718,
   "emotion": "froh",
   "text": "Twelve years ago, you turned in a red stuffed bird here."
  },
  {
   "nr": 2,
   "typ": "objekt",
   "kapitel": 1,
   "start": 4.718,
   "dauer": 3.062,
   "emotion": "erklaerend",
   "text": "You were five. And you don't remember any of it."
  },
  {
   "nr": 3,
   "typ": "objekt",
   "kapitel": 2,
   "start": 7.78,
   "dauer": 4.142,
   "emotion": "erklaerend",
   "text": "Your dad hands you the old receipt. The paper is soft as cloth."
  },
  {
   "nr": 4,
   "typ": "gesicht",
   "kapitel": 2,
   "start": 11.922,
   "dauer": 2.726,
   "emotion": "froh",
   "text": "“You found it in the park. In the rain.”"
  },
  {
   "nr": 5,
   "typ": "park",
   "kapitel": 2,
   "start": 14.648,
   "dauer": 5.054,
   "emotion": "erzaehlend",
   "text": "A red velvet bird. One wing smaller than the other, sewn on crooked."
  },
  {
   "nr": 6,
   "typ": "gesicht",
   "kapitel": 2,
   "start": 19.702,
   "dauer": 3.038,
   "emotion": "froh",
   "text": "“You didn't want to let go. You cried.”"
  },
  {
   "nr": 7,
   "typ": "gesicht",
   "kapitel": 2,
   "start": 22.74,
   "dauer": 1.694,
   "emotion": "froh",
   "text": "That sounds a lot like you."
  },
  {
   "nr": 8,
   "typ": "fundhaus",
   "kapitel": 2,
   "start": 24.434,
   "dauer": 4.238,
   "emotion": "erzaehlend",
   "text": "But you turned it in. On shelf twelve. Of all places."
  },
  {
   "nr": 9,
   "typ": "gesicht",
   "kapitel": 3,
   "start": 28.672,
   "dauer": 3.662,
   "emotion": "erzaehlend",
   "text": "“The next day, a little boy came in. With glasses.”"
  },
  {
   "nr": 10,
   "typ": "objekt",
   "kapitel": 3,
   "start": 32.334,
   "dauer": 5.966,
   "emotion": "erklaerend",
   "text": "Two kids' signatures. Yours, as finder. Underneath, huge and crooked: Sami."
  },
  {
   "nr": 11,
   "typ": "gesicht",
   "kapitel": 3,
   "start": 38.3,
   "dauer": 3.278,
   "emotion": "spannend",
   "text": "This is where you met him. At this exact counter."
  },
  {
   "nr": 12,
   "typ": "gesicht",
   "kapitel": 3,
   "start": 41.578,
   "dauer": 2.174,
   "emotion": "froh",
   "text": "“You two played together the whole afternoon.”"
  },
  {
   "nr": 13,
   "typ": "wohnzimmer",
   "kapitel": 3,
   "start": 43.752,
   "dauer": 5.342,
   "emotion": "erzaehlend",
   "text": "Ever since: every birthday, every school trip, every bad day."
  },
  {
   "nr": 14,
   "typ": "gesicht",
   "kapitel": 3,
   "start": 49.094,
   "dauer": 3.566,
   "emotion": "froh",
   "text": "And today, you almost lost him. Over paper."
  },
  {
   "nr": 15,
   "typ": "objekt",
   "kapitel": 4,
   "start": 52.66,
   "dauer": 4.886,
   "emotion": "erklaerend",
   "text": "Today, his name was on a fake receipt. Back then, his first real one."
  },
  {
   "nr": 16,
   "typ": "fundhaus",
   "kapitel": 4,
   "start": 57.546,
   "dauer": 3.038,
   "emotion": "erzaehlend",
   "text": "You lay both under the counter glass. There they stay."
  },
  {
   "nr": 17,
   "typ": "gesicht",
   "kapitel": 4,
   "start": 60.584,
   "dauer": 2.342,
   "emotion": "froh",
   "text": "“Some things, you find twice.”"
  },
  {
   "nr": 18,
   "typ": "fundhaus",
   "kapitel": 4,
   "start": 62.926,
   "dauer": 4.07,
   "emotion": "erzaehlend",
   "text": "Sami stands next to you, completely still. The yard turns orange."
  },
  {
   "nr": 19,
   "typ": "gesicht",
   "kapitel": 4,
   "start": 66.996,
   "dauer": 2.486,
   "emotion": "froh",
   "text": "“I never thanked you. For finding it.”"
  },
  {
   "nr": 20,
   "typ": "gesicht",
   "kapitel": 4,
   "start": 69.482,
   "dauer": 2.87,
   "emotion": "froh",
   "text": "“You did. Today. You came back.”"
  },
  {
   "nr": 21,
   "typ": "gesicht",
   "kapitel": 5,
   "start": 72.352,
   "dauer": 2.078,
   "emotion": "froh",
   "text": "Then he reaches into his jacket pocket."
  },
  {
   "nr": 22,
   "typ": "objekt",
   "kapitel": 5,
   "start": 74.43,
   "dauer": 4.982,
   "emotion": "erklaerend",
   "text": "A red stuffed bird. One wing smaller. He's carried it for twelve years."
  }
 ]
