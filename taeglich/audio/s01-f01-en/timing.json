{
 "dauer": 75.64,
 "einstellungen": [
  {
   "nr": 1,
   "typ": "netz",
   "kapitel": 1,
   "start": 0.0,
   "dauer": 4.502,
   "emotion": "erzaehlend",
   "text": "The internet is gone. And your sister never came home."
  },
  {
   "nr": 2,
   "typ": "zimmer",
   "kapitel": 1,
   "start": 4.502,
   "dauer": 3.206,
   "emotion": "spannend",
   "text": "Six in the morning. Mom bursts through your door."
  },
  {
   "nr": 3,
   "typ": "gesicht",
   "kapitel": 1,
   "start": 7.708,
   "dauer": 2.342,
   "emotion": "spannend",
   "text": "“Lina's not here. Her bed is empty.”"
  },
  {
   "nr": 4,
   "typ": "handy",
   "kapitel": 1,
   "start": 10.05,
   "dauer": 3.47,
   "emotion": "erzaehlend",
   "text": "You grab your phone. No bars. No Wi-Fi."
  },
  {
   "nr": 5,
   "typ": "wohnzimmer",
   "kapitel": 2,
   "start": 13.52,
   "dauer": 3.83,
   "emotion": "ernst",
   "text": "Lina slept over at a friend's place. All the way across town."
  },
  {
   "nr": 6,
   "typ": "gesicht",
   "kapitel": 2,
   "start": 17.35,
   "dauer": 3.878,
   "emotion": "ernst",
   "text": "Dad tries calling. Nothing. Not even a dial tone."
  },
  {
   "nr": 7,
   "typ": "weltall",
   "kapitel": 2,
   "start": 21.228,
   "dauer": 4.838,
   "emotion": "erzaehlend",
   "text": "And it's not just you. Last night, the network went down all over the world."
  },
  {
   "nr": 8,
   "typ": "netz",
   "kapitel": 2,
   "start": 26.066,
   "dauer": 4.094,
   "emotion": "erzaehlend",
   "text": "No texts. No calls. No map to show you the way."
  },
  {
   "nr": 9,
   "typ": "gesicht",
   "kapitel": 3,
   "start": 30.16,
   "dauer": 3.686,
   "emotion": "ernst",
   "text": "Dad grabs the car keys. “We're getting her. Now.”"
  },
  {
   "nr": 10,
   "typ": "grossstadt",
   "kapitel": 3,
   "start": 33.846,
   "dauer": 4.622,
   "emotion": "erzaehlend",
   "text": "The city is strangely quiet. The traffic lights just blink yellow."
  },
  {
   "nr": 11,
   "typ": "haltestelle",
   "kapitel": 3,
   "start": 38.468,
   "dauer": 4.886,
   "emotion": "erzaehlend",
   "text": "At the bus stop, everyone is staring at their phones. Like that's going to change anything."
  },
  {
   "nr": 12,
   "typ": "objekt",
   "kapitel": 3,
   "start": 43.354,
   "dauer": 5.054,
   "emotion": "erklaerend",
   "text": "No card payments. No online tickets. Almost everything runs on the network."
  },
  {
   "nr": 13,
   "typ": "gesicht",
   "kapitel": 3,
   "start": 48.408,
   "dauer": 5.486,
   "emotion": "ernst",
   "text": "In the car, you count the minutes. Lina is twelve. She's never been alone in the city at night."
  },
  {
   "nr": 14,
   "typ": "grossstadt",
   "kapitel": 3,
   "start": 53.894,
   "dauer": 2.126,
   "emotion": "erzaehlend",
   "text": "Twenty minutes later, you're there."
  },
  {
   "nr": 15,
   "typ": "wohnzimmer",
   "kapitel": 4,
   "start": 56.02,
   "dauer": 3.662,
   "emotion": "erzaehlend",
   "text": "The front door is open a crack. “Hello? Lina?”"
  },
  {
   "nr": 16,
   "typ": "gesicht",
   "kapitel": 4,
   "start": 59.682,
   "dauer": 3.614,
   "emotion": "ernst",
   "text": "No answer. The jackets are gone. The shoes are gone."
  },
  {
   "nr": 17,
   "typ": "esstisch",
   "kapitel": 4,
   "start": 63.296,
   "dauer": 3.83,
   "emotion": "erzaehlend",
   "text": "The plates are still on the table. Like everyone left in the middle of the night."
  },
  {
   "nr": 18,
   "typ": "gesicht",
   "kapitel": 4,
   "start": 67.126,
   "dauer": 1.982,
   "emotion": "spannend",
   "text": "Dad goes completely pale."
  },
  {
   "nr": 19,
   "typ": "gesicht",
   "kapitel": 5,
   "start": 69.108,
   "dauer": 1.022,
   "emotion": "spannend",
   "text": "Then you see it."
  },
  {
   "nr": 20,
   "typ": "handy",
   "kapitel": 5,
   "start": 70.13,
   "dauer": 5.51,
   "emotion": "erzaehlend",
   "text": "Right in the middle of the table is Lina's phone. She left without it. In the middle of the night."
  }
 ]
