   "nr": 7,
   "typ": "titel",
   "kapitel": 1,
   "start": 25.068,
   "dauer": 4.598,
   "emotion": "erzaehlend",
   "text": "But one tube won't reach. Germany to Denmark is eleven miles of sea."
  },
  {
   "nr": 8,
   "typ": "meertunnel",
   "kapitel": 1,
   "start": 29.666,
   "dauer": 4.934,
   "emotion": "erzaehlend",
   "text": "So you build a factory on the coast. Every piece is seven hundred twelve feet long."
