  {
   "nr": 10,
   "typ": "meertunnel",
   "kapitel": 1,
   "start": 38.958,
   "dauer": 3.278,
   "emotion": "erzaehlend",
   "text": "And you need eighty-nine of them, joined underwater."
  },
  {
   "nr": 11,
   "typ": "meertunnel",
   "kapitel": 2,
   "start": 42.236,
   "dauer": 2.726,
   "emotion": "erzaehlend",
   "text": "Because your family is riding the very first train."
  },
