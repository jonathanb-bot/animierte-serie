  {
   "nr": 9,
   "typ": "meertunnel",
   "kapitel": 1,
   "start": 34.6,
   "dauer": 4.358,
   "emotion": "erzaehlend",
   "text": "Seventy-three thousand metric tons. Tugboats drag it out to sea."
