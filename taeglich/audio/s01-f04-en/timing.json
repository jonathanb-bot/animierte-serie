{
 "dauer": 72.18,
 "einstellungen": [
  {
   "nr": 1,
   "typ": "landschaft",
   "kapitel": 1,
   "start": 0.0,
   "dauer": 4.934,
   "emotion": "erzaehlend",
   "text": "In the middle of the night, someone answers a signal only two people know."
  },
  {
   "nr": 2,
   "typ": "gesicht",
   "kapitel": 1,
   "start": 4.934,
   "dauer": 4.526,
   "emotion": "ernst",
   "text": "You take off running. Through wet leaves, straight across the grass."
  },
  {
   "nr": 3,
   "typ": "park",
   "kapitel": 2,
   "start": 9.46,
   "dauer": 6.878,
   "emotion": "erzaehlend",
   "text": "Under the roof of the old gazebo, a candle is burning. Next to it, an old man with a blanket."
  },
  {
   "nr": 4,
   "typ": "gesicht",
   "kapitel": 2,
   "start": 16.338,
   "dauer": 2.294,
   "emotion": "froh",
   "text": "And under the blanket: Lina."
  },
  {
   "nr": 5,
   "typ": "park",
   "kapitel": 2,
   "start": 18.632,
   "dauer": 3.038,
   "emotion": "erzaehlend",
   "text": "You hold her so tight she has to laugh."
  },
  {
   "nr": 6,
   "typ": "gesicht",
   "kapitel": 2,
   "start": 21.67,
   "dauer": 1.406,
   "emotion": "froh",
   "text": "“You're squishing me!”"
  },
  {
   "nr": 7,
   "typ": "gesicht",
   "kapitel": 2,
   "start": 23.076,
   "dauer": 3.59,
   "emotion": "froh",
   "text": "Ben turns away. He says it's just the rain."
  },
  {
   "nr": 8,
   "typ": "gesicht",
   "kapitel": 3,
   "start": 26.666,
   "dauer": 3.374,
   "emotion": "traurig",
   "text": "“Grandpa's all alone. I just wanted to check if he's okay.”"
  },
  {
   "nr": 9,
   "typ": "gesicht",
   "kapitel": 3,
   "start": 30.04,
   "dauer": 4.982,
   "emotion": "traurig",
   "text": "And you realize: she was thinking about Grandpa. You didn't think of him once."
  },
  {
   "nr": 10,
   "typ": "gesicht",
   "kapitel": 3,
   "start": 35.022,
   "dauer": 5.63,
   "emotion": "froh",
   "text": "The old man heard her crying in the dark. “I said: we'll wait together. Until it gets light.”"
  },
  {
   "nr": 11,
   "typ": "objekt",
   "kapitel": 3,
   "start": 40.652,
   "dauer": 4.814,
   "emotion": "erklaerend",
   "text": "He's got everything with him. A candle, a blanket. And an old radio."
  },
  {
   "nr": 12,
   "typ": "landschaft",
   "kapitel": 3,
   "start": 45.466,
   "dauer": 3.902,
   "emotion": "erzaehlend",
   "text": "You wait together. And then the sun comes up over the rooftops."
  },
  {
   "nr": 13,
   "typ": "grossstadt",
   "kapitel": 3,
   "start": 49.368,
   "dauer": 4.118,
   "emotion": "erzaehlend",
   "text": "The city still has no power. But right now, you don't care."
  },
  {
   "nr": 14,
   "typ": "gesicht",
   "kapitel": 4,
   "start": 53.486,
   "dauer": 5.606,
   "emotion": "froh",
   "text": "Lina splits her last cookie into three pieces. For you, for Ben, for the old man."
  },
  {
   "nr": 15,
   "typ": "gesicht",
   "kapitel": 4,
   "start": 59.092,
   "dauer": 2.654,
   "emotion": "froh",
   "text": "For the first time in a day, you laugh."
  },
  {
   "nr": 16,
   "typ": "gesicht",
   "kapitel": 4,
   "start": 61.746,
   "dauer": 4.094,
   "emotion": "ernst",
   "text": "Only the old man doesn't laugh along. He's holding the radio to his ear."
  },
  {
   "nr": 17,
   "typ": "netz",
   "kapitel": 5,
   "start": 65.84,
   "dauer": 4.262,
   "emotion": "erzaehlend",
   "text": "“I was a radio operator for forty years. I know what happened last night.”"
  },
  {
   "nr": 18,
   "typ": "weltall",
   "kapitel": 5,
   "start": 70.102,
   "dauer": 2.078,
   "emotion": "erzaehlend",
   "text": "“And that was just the beginning.”"
  }
 ]
}