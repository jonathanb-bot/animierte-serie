{
 "dauer": 71.114,
 "einstellungen": [
  {
   "nr": 1,
   "typ": "grossstadt",
   "kapitel": 1,
   "start": 0.0,
   "dauer": 6.758,
   "emotion": "erzaehlend",
   "text": "As of today, you're a millionaire. And rule number one is: keep your mouth shut."
  },
  {
   "nr": 2,
   "typ": "rechenzentrum",
   "kapitel": 1,
   "start": 6.758,
   "dauer": 5.342,
   "emotion": "erzaehlend",
   "text": "The lottery office. Cold air, a low hum, a room with no windows."
  },
  {
   "nr": 3,
   "typ": "gesicht",
   "kapitel": 1,
   "start": 12.1,
   "dauer": 2.366,
   "emotion": "erzaehlend",
   "text": "“Tell as few people as possible.”"
  },
  {
   "nr": 4,
   "typ": "gesicht",
   "kapitel": 1,
   "start": 14.466,
   "dauer": 2.126,
   "emotion": "froh",
   "text": "“And don't buy anything big this week.”"
  },
  {
   "nr": 5,
   "typ": "objekt",
   "kapitel": 2,
   "start": 16.592,
   "dauer": 3.83,
   "emotion": "erklaerend",
   "text": "Nobody here is going to publish your name. That's how it usually works."
  },
  {
   "nr": 6,
   "typ": "gesicht",
   "kapitel": 2,
   "start": 20.422,
   "dauer": 5.102,
   "emotion": "ernst",
   "text": "You nod. Very seriously. Like a secret agent with a school backpack."
  },
  {
   "nr": 7,
   "typ": "netz",
   "kapitel": 2,
   "start": 25.524,
   "dauer": 3.638,
   "emotion": "erzaehlend",
   "text": "She says winners suddenly get calls from people they haven't seen in years."
  },
  {
   "nr": 8,
   "typ": "handy",
   "kapitel": 3,
   "start": 29.162,
   "dauer": 4.046,
   "emotion": "erzaehlend",
   "text": "By noon, your account shows a number that barely fits on the screen."
  },
  {
   "nr": 9,
   "typ": "gesicht",
   "kapitel": 3,
   "start": 33.208,
   "dauer": 4.094,
   "emotion": "spannend",
   "text": "You count the zeros three times. Still six."
  },
  {
   "nr": 10,
   "typ": "grossstadt",
   "kapitel": 3,
   "start": 37.302,
   "dauer": 3.35,
   "emotion": "froh",
   "text": "You could buy an apartment right now. Or five."
  },
  {
   "nr": 11,
   "typ": "gesicht",
   "kapitel": 3,
   "start": 40.652,
   "dauer": 2.87,
   "emotion": "erzaehlend",
   "text": "But the back of that ticket says “For all of us.”"
  },
  {
   "nr": 12,
   "typ": "wohnzimmer",
   "kapitel": 3,
   "start": 43.522,
   "dauer": 4.766,
   "emotion": "erzaehlend",
   "text": "At home, it smells like fried potatoes. Lina's fighting Dad for the remote."
  },
  {
   "nr": 13,
   "typ": "gesicht",
   "kapitel": 3,
   "start": 48.288,
   "dauer": 2.438,
   "emotion": "froh",
   "text": "“So? How was your first day as an adult?”"
  },
  {
   "nr": 14,
   "typ": "gesicht",
   "kapitel": 4,
   "start": 50.726,
   "dauer": 1.238,
   "emotion": "ernst",
   "text": "You open your mouth."
  },
  {
   "nr": 15,
   "typ": "wohnzimmer",
   "kapitel": 4,
   "start": 51.964,
   "dauer": 2.918,
   "emotion": "erzaehlend",
   "text": "“Boring,” you say. And everyone nods."
  },
  {
   "nr": 16,
   "typ": "weltall",
   "kapitel": 4,
   "start": 54.882,
   "dauer": 4.502,
   "emotion": "erzaehlend",
   "text": "The lie comes out surprisingly easy. And that's exactly what scares you."
  },
  {
   "nr": 17,
   "typ": "zimmer",
   "kapitel": 5,
   "start": 59.384,
   "dauer": 3.59,
   "emotion": "erzaehlend",
   "text": "That night, you hide the ticket in an old tin box under your bed."
  },
  {
   "nr": 18,
   "typ": "gesicht",
   "kapitel": 5,
   "start": 62.974,
   "dauer": 5.678,
   "emotion": "ernst",
   "text": "You decide: until Grandpa's birthday on Sunday, nobody finds out. Not even Mia."
  },
  {
   "nr": 19,
   "typ": "handy",
   "kapitel": 5,
   "start": 68.652,
   "dauer": 2.462,
   "emotion": "erzaehlend",
   "text": "It'll be the worst decision you make all year."
  }
 ]
}