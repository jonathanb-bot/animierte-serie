{
 "dauer": 80.714,
 "einstellungen": [
  {
   "nr": 1,
   "typ": "krankenhaus",
   "kapitel": 1,
   "start": 0.0,
   "dauer": 5.078,
   "emotion": "erzaehlend",
   "text": "Dein Opa liegt im Krankenhaus. Und er weiß, dass du Millionär bist."
  },
  {
   "nr": 2,
   "typ": "gesicht",
   "kapitel": 1,
   "start": 5.078,
   "dauer": 3.926,
   "emotion": "froh",
   "text": "„Der Kioskmann ist mein Skatbruder. Der kann nichts für sich behalten.“"
  },
  {
   "nr": 3,
   "typ": "gesicht",
   "kapitel": 1,
   "start": 9.004,
   "dauer": 4.958,
   "emotion": "spannend",
   "text": "Seit einer Woche lügst du alle an. Und Opa wusste es die ganze Zeit."
  },
  {
   "nr": 4,
   "typ": "krankenhaus",
   "kapitel": 2,
   "start": 13.962,
   "dauer": 4.742,
   "emotion": "erzaehlend",
   "text": "Seine Brille liegt auf dem Nachttisch. Ohne sie sieht er plötzlich sehr alt aus."
  },
  {
   "nr": 5,
   "typ": "gesicht",
   "kapitel": 2,
   "start": 18.704,
   "dauer": 3.758,
   "emotion": "erzaehlend",
   "text": "„Hüfte. Halb so wild. Unkraut vergeht nicht.“"
  },
  {
   "nr": 6,
   "typ": "gesicht",
   "kapitel": 2,
   "start": 22.462,
   "dauer": 5.198,
   "emotion": "traurig",
   "text": "Und dann erzählst du ihm alles. Das Geld. Die Lügen. Mia."
  },
  {
   "nr": 7,
   "typ": "gesicht",
   "kapitel": 2,
   "start": 27.66,
   "dauer": 6.35,
   "emotion": "erzaehlend",
   "text": "Opa hört zu, ohne einmal zu unterbrechen. Das kann er besser als jeder andere."
  },
  {
   "nr": 8,
   "typ": "lebenszeit",
   "kapitel": 3,
   "start": 34.01,
   "dauer": 5.414,
   "emotion": "erzaehlend",
   "text": "Opa hat einundvierzig Jahre lang jeden Samstag dieselben Zahlen gespielt."
  },
  {
   "nr": 9,
   "typ": "objekt",
   "kapitel": 3,
   "start": 39.424,
   "dauer": 7.286,
   "emotion": "erklaerend",
   "text": "Es sind keine Glückszahlen. Es sind Geburtstage. Oma, Mama, Papa, Lina. Und deiner."
  },
  {
   "nr": 10,
   "typ": "gesicht",
   "kapitel": 3,
   "start": 46.71,
   "dauer": 4.118,
   "emotion": "erzaehlend",
   "text": "„Ich wollte nie gewinnen. Ich wollte nur jede Woche an euch denken.“"
  },
  {
   "nr": 11,
   "typ": "esstisch",
   "kapitel": 3,
   "start": 50.828,
   "dauer": 6.254,
   "emotion": "erzaehlend",
   "text": "Jeden Sonntag saß die ganze Familie bei ihm am Tisch. Bis alle irgendwann zu beschäftigt waren."
  },
  {
   "nr": 12,
   "typ": "landschaft",
   "kapitel": 3,
   "start": 57.082,
   "dauer": 2.294,
   "emotion": "erzaehlend",
   "text": "Das letzte Mal ist acht Monate her."
  },
  {
   "nr": 13,
   "typ": "gesicht",
   "kapitel": 3,
   "start": 59.376,
   "dauer": 1.406,
   "emotion": "traurig",
   "text": "Und du warst auch nicht da."
  },
  {
   "nr": 14,
   "typ": "gesicht",
   "kapitel": 4,
   "start": 60.782,
   "dauer": 4.358,
   "emotion": "froh",
   "text": "„Für uns alle, hab ich geschrieben. Nicht für jeden einzeln.“"
  },
  {
   "nr": 15,
   "typ": "gesicht",
   "kapitel": 4,
   "start": 65.14,
   "dauer": 3.014,
   "emotion": "erzaehlend",
   "text": "Du verstehst nicht ganz, was er meint. Noch nicht."
  },
  {
   "nr": 16,
   "typ": "esstisch",
   "kapitel": 4,
   "start": 68.154,
   "dauer": 3.374,
   "emotion": "erzaehlend",
   "text": "Du denkst an seinen Esstisch. An die leeren Stühle."
  },
  {
   "nr": 17,
   "typ": "polarlicht",
   "kapitel": 4,
   "start": 71.528,
   "dauer": 1.838,
   "emotion": "erzaehlend",
   "text": "Draußen dämmert schon der Morgen."
  },
  {
   "nr": 18,
   "typ": "gesicht",
   "kapitel": 5,
   "start": 73.366,
   "dauer": 3.014,
   "emotion": "ernst",
   "text": "„Aber zuerst gehst du zu Mia. Heute noch.“"
  },
  {
   "nr": 19,
   "typ": "grossstadt",
   "kapitel": 5,
   "start": 76.38,
   "dauer": 4.334,
   "emotion": "erzaehlend",
   "text": "Also rennst du. Wie ein Pinguin mit Rucksack. Direkt zu Mia."
  }
 ]
}