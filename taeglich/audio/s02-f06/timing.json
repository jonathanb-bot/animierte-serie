{
 "dauer": 75.386,
 "einstellungen": [
  {
   "nr": 1,
   "typ": "krankenhaus",
   "kapitel": 1,
   "start": 0.0,
   "dauer": 4.886,
   "emotion": "erzaehlend",
   "text": "Dein Opa liegt im Krankenhaus. Und er weiß, dass du Millionär bist."
  },
  {
   "nr": 2,
   "typ": "gesicht",
   "kapitel": 1,
   "start": 4.886,
   "dauer": 3.926,
   "emotion": "froh",
   "text": "„Der Kioskmann ist mein Skatbruder. Der kann nichts für sich behalten.“"
  },
  {
   "nr": 3,
   "typ": "gesicht",
   "kapitel": 1,
   "start": 8.812,
   "dauer": 4.142,
   "emotion": "spannend",
   "text": "Seit einer Woche lügst du alle an. Und Opa wusste es die ganze Zeit."
  },
  {
   "nr": 4,
   "typ": "krankenhaus",
   "kapitel": 2,
   "start": 12.954,
   "dauer": 5.078,
   "emotion": "erzaehlend",
   "text": "Seine Brille liegt auf dem Nachttisch. Ohne sie sieht er plötzlich sehr alt aus."
  },
  {
   "nr": 5,
   "typ": "gesicht",
   "kapitel": 2,
   "start": 18.032,
   "dauer": 3.062,
   "emotion": "erzaehlend",
   "text": "„Hüfte. Halb so wild. Unkraut vergeht nicht.“"
  },
  {
   "nr": 6,
   "typ": "gesicht",
   "kapitel": 2,
   "start": 21.094,
   "dauer": 4.382,
   "emotion": "traurig",
   "text": "Und dann erzählst du ihm alles. Das Geld. Die Lügen. Mia."
  },
  {
   "nr": 7,
   "typ": "gesicht",
   "kapitel": 2,
   "start": 25.476,
   "dauer": 4.91,
   "emotion": "erzaehlend",
   "text": "Opa hört zu, ohne einmal zu unterbrechen. Das kann er besser als jeder andere."
  },
  {
   "nr": 8,
   "typ": "lebenszeit",
   "kapitel": 3,
   "start": 30.386,
   "dauer": 4.862,
   "emotion": "erzaehlend",
   "text": "Opa hat einundvierzig Jahre lang jeden Samstag dieselben Zahlen gespielt."
  },
  {
   "nr": 9,
   "typ": "objekt",
   "kapitel": 3,
   "start": 35.248,
   "dauer": 6.95,
   "emotion": "erklaerend",
   "text": "Es sind keine Glückszahlen. Es sind Geburtstage. Oma, Mama, Papa, Lina. Und deiner."
  },
  {
   "nr": 10,
   "typ": "gesicht",
   "kapitel": 3,
   "start": 42.198,
   "dauer": 4.166,
   "emotion": "erzaehlend",
   "text": "„Ich wollte nie gewinnen. Ich wollte nur jede Woche an euch denken.“"
  },
  {
   "nr": 11,
   "typ": "esstisch",
   "kapitel": 3,
   "start": 46.364,
   "dauer": 5.894,
   "emotion": "erzaehlend",
   "text": "Jeden Sonntag saß die ganze Familie bei ihm am Tisch. Bis alle irgendwann zu beschäftigt waren."
  },
  {
   "nr": 12,
   "typ": "landschaft",
   "kapitel": 3,
   "start": 52.258,
   "dauer": 2.366,
   "emotion": "erzaehlend",
   "text": "Das letzte Mal ist acht Monate her."
  },
  {
   "nr": 13,
   "typ": "gesicht",
   "kapitel": 3,
   "start": 54.624,
   "dauer": 1.742,
   "emotion": "traurig",
   "text": "Und du warst auch nicht da."
  },
  {
   "nr": 14,
   "typ": "gesicht",
   "kapitel": 4,
   "start": 56.366,
   "dauer": 4.046,
   "emotion": "froh",
   "text": "„Für uns alle, hab ich geschrieben. Nicht für jeden einzeln.“"
  },
  {
   "nr": 15,
   "typ": "gesicht",
   "kapitel": 4,
   "start": 60.412,
   "dauer": 2.678,
   "emotion": "erzaehlend",
   "text": "Du verstehst nicht ganz, was er meint. Noch nicht."
  },
  {
   "nr": 16,
   "typ": "esstisch",
   "kapitel": 4,
   "start": 63.09,
   "dauer": 3.302,
   "emotion": "erzaehlend",
   "text": "Du denkst an seinen Esstisch. An die leeren Stühle."
  },
  {
   "nr": 17,
   "typ": "polarlicht",
   "kapitel": 4,
   "start": 66.392,
   "dauer": 1.646,
   "emotion": "erzaehlend",
   "text": "Draußen dämmert schon der Morgen."
  },
  {
   "nr": 18,
   "typ": "gesicht",
   "kapitel": 5,
   "start": 68.038,
   "dauer": 2.774,
   "emotion": "ernst",
   "text": "„Aber zuerst gehst du zu Mia. Heute noch.“"
  },
  {
   "nr": 19,
   "typ": "grossstadt",
   "kapitel": 5,
   "start": 70.812,
   "dauer": 4.574,
   "emotion": "erzaehlend",
   "text": "Also rennst du. Wie ein Pinguin mit Rucksack. Direkt zu Mia."
  }
 ]
}