{
 "dauer": 72.012,
 "einstellungen": [
  {
   "nr": 1,
   "typ": "landschaft",
   "kapitel": 1,
   "start": 0.0,
   "dauer": 5.054,
   "emotion": "erzaehlend",
   "text": "Mitten in der Nacht antwortet jemand auf ein Zeichen, das nur zwei Menschen kennen."
  },
  {
   "nr": 2,
   "typ": "gesicht",
   "kapitel": 1,
   "start": 5.054,
   "dauer": 4.022,
   "emotion": "ernst",
   "text": "Du rennst los. Durch nasses Laub, quer über den Rasen."
  },
  {
   "nr": 3,
   "typ": "park",
   "kapitel": 2,
   "start": 9.076,
   "dauer": 5.438,
   "emotion": "erzaehlend",
   "text": "Unter dem Dach vom alten Pavillon brennt eine Kerze. Daneben ein alter Mann mit Decke."
  },
  {
   "nr": 4,
   "typ": "gesicht",
   "kapitel": 2,
   "start": 14.514,
   "dauer": 2.63,
   "emotion": "froh",
   "text": "Und unter der Decke: Lina."
  },
  {
   "nr": 5,
   "typ": "park",
   "kapitel": 2,
   "start": 17.144,
   "dauer": 2.678,
   "emotion": "erzaehlend",
   "text": "Du hältst sie so fest, dass sie lachen muss."
  },
  {
   "nr": 6,
   "typ": "gesicht",
   "kapitel": 2,
   "start": 19.822,
   "dauer": 1.43,
   "emotion": "froh",
   "text": "„Du zerquetschst mich!“"
  },
  {
   "nr": 7,
   "typ": "gesicht",
   "kapitel": 2,
   "start": 21.252,
   "dauer": 3.59,
   "emotion": "froh",
   "text": "Ben dreht sich weg. Er sagt, es ist nur der Regen."
  },
  {
   "nr": 8,
   "typ": "gesicht",
   "kapitel": 3,
   "start": 24.842,
   "dauer": 4.046,
   "emotion": "traurig",
   "text": "„Opa ist doch ganz allein. Ich wollte nur nachsehen, ob es ihm gut geht.“"
  },
  {
   "nr": 9,
   "typ": "gesicht",
   "kapitel": 3,
   "start": 28.888,
   "dauer": 4.574,
   "emotion": "traurig",
   "text": "Und du merkst: Sie hat an Opa gedacht. Du nicht ein einziges Mal."
  },
  {
   "nr": 10,
   "typ": "gesicht",
   "kapitel": 3,
   "start": 33.462,
   "dauer": 5.75,
   "emotion": "froh",
   "text": "Der alte Mann hat sie im Dunkeln weinen hören. „Ich hab gesagt: Wir warten zusammen. Bis es hell wird.“"
  },
  {
   "nr": 11,
   "typ": "objekt",
   "kapitel": 3,
   "start": 39.212,
   "dauer": 5.342,
   "emotion": "erklaerend",
   "text": "Er hat alles dabei. Kerze, Decke. Und ein altes Funkgerät."
  },
  {
   "nr": 12,
   "typ": "landschaft",
   "kapitel": 3,
   "start": 44.554,
   "dauer": 4.046,
   "emotion": "erzaehlend",
   "text": "Ihr wartet zusammen. Und dann geht über den Dächern die Sonne auf."
  },
  {
   "nr": 13,
   "typ": "grossstadt",
   "kapitel": 3,
   "start": 48.6,
   "dauer": 4.07,
   "emotion": "erzaehlend",
   "text": "Die Stadt hat immer noch keinen Strom. Aber gerade ist dir das egal."
  },
  {
   "nr": 14,
   "typ": "gesicht",
   "kapitel": 4,
   "start": 52.67,
   "dauer": 5.894,
   "emotion": "froh",
   "text": "Lina teilt ihren letzten Keks in drei Teile. Für dich, für Ben, für den alten Mann."
  },
  {
   "nr": 15,
   "typ": "gesicht",
   "kapitel": 4,
   "start": 58.564,
   "dauer": 2.966,
   "emotion": "froh",
   "text": "Zum ersten Mal seit einem Tag lachst du."
  },
  {
   "nr": 16,
   "typ": "gesicht",
   "kapitel": 4,
   "start": 61.53,
   "dauer": 4.022,
   "emotion": "ernst",
   "text": "Nur der alte Mann lacht nicht mit. Er hält das Funkgerät ans Ohr."
  },
  {
   "nr": 17,
   "typ": "netz",
   "kapitel": 5,
   "start": 65.552,
   "dauer": 4.286,
   "emotion": "erzaehlend",
   "text": "„Ich war vierzig Jahre Funker. Ich weiß, was heute Nacht passiert ist.“"
  },
  {
   "nr": 18,
   "typ": "weltall",
   "kapitel": 5,
   "start": 69.838,
   "dauer": 2.174,
   "emotion": "erzaehlend",
   "text": "„Und das war erst der Anfang.“"
  }
 ]
}