{
 "dauer": 67.994,
 "einstellungen": [
  {
   "nr": 1,
   "typ": "grossstadt",
   "kapitel": 1,
   "start": 0.0,
   "dauer": 6.278,
   "emotion": "erzaehlend",
   "text": "You're a millionaire. And you have exactly fourteen minutes not to lose your best friend."
  },
  {
   "nr": 2,
   "typ": "gesicht",
   "kapitel": 1,
   "start": 6.278,
   "dauer": 4.43,
   "emotion": "ernst",
   "text": "Ben calls. “Mia's leaving. Half a year. Not a joke.”"
  },
  {
   "nr": 3,
   "typ": "gesicht",
   "kapitel": 1,
   "start": 10.708,
   "dauer": 3.974,
   "emotion": "spannend",
   "text": "Half a year. And she didn't tell you. Just like you didn't tell her."
  },
  {
   "nr": 4,
   "typ": "handy",
   "kapitel": 1,
   "start": 14.682,
   "dauer": 2.03,
   "emotion": "erzaehlend",
   "text": "The train leaves at eight twelve."
  },
  {
   "nr": 5,
   "typ": "haltestelle",
   "kapitel": 2,
   "start": 16.712,
   "dauer": 5.486,
   "emotion": "erzaehlend",
   "text": "No bus. No cab. You have thirty million dollars and not a single car."
  },
  {
   "nr": 6,
   "typ": "grossstadt",
   "kapitel": 2,
   "start": 22.198,
   "dauer": 3.854,
   "emotion": "erzaehlend",
   "text": "So you run. For the first time in your life, without complaining."
  },
  {
   "nr": 7,
   "typ": "landschaft",
   "kapitel": 2,
   "start": 26.052,
   "dauer": 3.566,
   "emotion": "erzaehlend",
   "text": "Across the park, over the bridge, past your bench."
  },
  {
   "nr": 8,
   "typ": "gesicht",
   "kapitel": 2,
   "start": 29.618,
   "dauer": 2.99,
   "emotion": "ernst",
   "text": "Your lungs are burning. Your shoes are soaked."
  },
  {
   "nr": 9,
   "typ": "bahnhof",
   "kapitel": 3,
   "start": 32.608,
   "dauer": 4.07,
   "emotion": "erzaehlend",
   "text": "The station is packed. Hundreds of people. And none of them is Mia."
  },
  {
   "nr": 10,
   "typ": "netz",
   "kapitel": 3,
   "start": 36.678,
   "dauer": 3.518,
   "emotion": "erzaehlend",
   "text": "You shout her name. A few people turn around. She doesn't."
  },
  {
   "nr": 11,
   "typ": "gesicht",
   "kapitel": 3,
   "start": 40.196,
   "dauer": 3.974,
   "emotion": "ernst",
   "text": "Red hat. No. Yellow suitcase. Not her either."
  },
  {
   "nr": 12,
   "typ": "handy",
   "kapitel": 3,
   "start": 44.17,
   "dauer": 3.206,
   "emotion": "erzaehlend",
   "text": "One minute left. Your battery: three percent."
  },
  {
   "nr": 13,
   "typ": "bahnhof",
   "kapitel": 3,
   "start": 47.376,
   "dauer": 3.83,
   "emotion": "erzaehlend",
   "text": "Platform three. The train is there. The doors are beeping."
  },
  {
   "nr": 14,
   "typ": "gesicht",
   "kapitel": 4,
   "start": 51.206,
   "dauer": 2.054,
   "emotion": "spannend",
   "text": "“Mia!” The doors close."
  },
  {
   "nr": 15,
   "typ": "bahnhof",
   "kapitel": 4,
   "start": 53.26,
   "dauer": 3.83,
   "emotion": "erzaehlend",
   "text": "The train pulls away. Slowly at first. Then it's gone."
  },
  {
   "nr": 16,
   "typ": "grossstadt",
   "kapitel": 4,
   "start": 57.09,
   "dauer": 2.366,
   "emotion": "erzaehlend",
   "text": "The lights of the train get smaller and smaller."
  },
  {
   "nr": 17,
   "typ": "gesicht",
   "kapitel": 4,
   "start": 59.456,
   "dauer": 5.462,
   "emotion": "traurig",
   "text": "You just stand there. With a dead phone and thirty million dollars that are no use at all."
  },
  {
   "nr": 18,
   "typ": "gesicht",
   "kapitel": 5,
   "start": 64.918,
   "dauer": 1.502,
   "emotion": "erzaehlend",
   "text": "Then someone behind you says:"
