{
 "dauer": 69.002,
 "einstellungen": [
  {
   "nr": 1,
   "typ": "grossstadt",
   "kapitel": 1,
   "start": 0.0,
   "dauer": 5.75,
   "emotion": "erzaehlend",
   "text": "You're a millionaire. And you have exactly fourteen minutes not to lose your best friend."
  },
  {
   "nr": 2,
   "typ": "gesicht",
   "kapitel": 1,
   "start": 5.75,
   "dauer": 4.526,
   "emotion": "ernst",
   "text": "Ben calls. “Mia's leaving. Half a year. Not a joke.”"
  },
  {
   "nr": 3,
   "typ": "gesicht",
   "kapitel": 1,
   "start": 10.276,
   "dauer": 4.478,
   "emotion": "spannend",
   "text": "Half a year. And she didn't tell you. Just like you didn't tell her."
  },
  {
   "nr": 4,
   "typ": "handy",
   "kapitel": 1,
   "start": 14.754,
   "dauer": 1.838,
   "emotion": "erzaehlend",
   "text": "The train leaves at eight twelve."
  },
  {
   "nr": 5,
   "typ": "haltestelle",
   "kapitel": 2,
   "start": 16.592,
   "dauer": 5.27,
   "emotion": "erzaehlend",
   "text": "No bus. No cab. You have thirty million dollars and not a single car."
  },
  {
   "nr": 6,
   "typ": "grossstadt",
   "kapitel": 2,
   "start": 21.862,
   "dauer": 3.806,
   "emotion": "erzaehlend",
   "text": "So you run. For the first time in your life, without complaining."
  },
  {
   "nr": 7,
   "typ": "landschaft",
   "kapitel": 2,
   "start": 25.668,
   "dauer": 3.614,
   "emotion": "erzaehlend",
   "text": "Across the park, over the bridge, past your bench."
  },
  {
   "nr": 8,
   "typ": "gesicht",
   "kapitel": 2,
   "start": 29.282,
   "dauer": 2.894,
   "emotion": "ernst",
   "text": "Your lungs are burning. Your shoes are soaked."
  },
  {
   "nr": 9,
   "typ": "bahnhof",
   "kapitel": 3,
   "start": 32.176,
   "dauer": 4.19,
   "emotion": "erzaehlend",
   "text": "The station is packed. Hundreds of people. And none of them is Mia."
  },
  {
   "nr": 10,
   "typ": "netz",
   "kapitel": 3,
   "start": 36.366,
   "dauer": 3.782,
   "emotion": "erzaehlend",
   "text": "You shout her name. A few people turn around. She doesn't."
  },
  {
   "nr": 11,
   "typ": "gesicht",
   "kapitel": 3,
   "start": 40.148,
   "dauer": 4.238,
   "emotion": "ernst",
   "text": "Red hat. No. Yellow suitcase. Not her either."
  },
  {
   "nr": 12,
   "typ": "handy",
   "kapitel": 3,
   "start": 44.386,
   "dauer": 3.59,
   "emotion": "erzaehlend",
   "text": "One minute left. Your battery: three percent."
  },
  {
   "nr": 13,
   "typ": "bahnhof",
   "kapitel": 3,
   "start": 47.976,
   "dauer": 3.878,
   "emotion": "erzaehlend",
   "text": "Platform three. The train is there. The doors are beeping."
  },
  {
   "nr": 14,
   "typ": "gesicht",
   "kapitel": 4,
   "start": 51.854,
   "dauer": 2.15,
   "emotion": "spannend",
   "text": "“Mia!” The doors close."
  },
  {
   "nr": 15,
   "typ": "bahnhof",
   "kapitel": 4,
   "start": 54.004,
   "dauer": 3.782,
   "emotion": "erzaehlend",
   "text": "The train pulls away. Slowly at first. Then it's gone."
  },
  {
   "nr": 16,
   "typ": "grossstadt",
   "kapitel": 4,
   "start": 57.786,
   "dauer": 2.462,
   "emotion": "erzaehlend",
   "text": "The lights of the train get smaller and smaller."
  },
  {
   "nr": 17,
   "typ": "gesicht",
   "kapitel": 4,
   "start": 60.248,
   "dauer": 5.366,
   "emotion": "traurig",
   "text": "You just stand there. With a dead phone and thirty million dollars that are no use at all."
  },
  {
   "nr": 18,
   "typ": "gesicht",
   "kapitel": 5,
   "start": 65.614,
   "dauer": 1.742,
   "emotion": "erzaehlend",
   "text": "Then someone behind you says:"
