{
 "dauer": 71.666,
 "einstellungen": [
  {
   "nr": 1,
   "typ": "krankenhaus",
   "kapitel": 1,
   "start": 0.0,
   "dauer": 3.878,
   "emotion": "erzaehlend",
   "text": "Your grandpa is in the hospital. And he knows you're a millionaire."
  },
  {
   "nr": 2,
   "typ": "gesicht",
   "kapitel": 1,
   "start": 3.878,
   "dauer": 3.71,
   "emotion": "froh",
   "text": "“The kiosk guy's my poker buddy. He can't keep a secret.”"
  },
  {
   "nr": 3,
   "typ": "gesicht",
   "kapitel": 1,
   "start": 7.588,
   "dauer": 4.43,
   "emotion": "spannend",
   "text": "For a week, you've been lying to everyone. And Grandpa knew the whole time."
  },
  {
   "nr": 4,
   "typ": "krankenhaus",
   "kapitel": 2,
   "start": 12.018,
   "dauer": 4.502,
   "emotion": "erzaehlend",
   "text": "His glasses are on the nightstand. Without them, he suddenly looks very old."
  },
  {
   "nr": 5,
   "typ": "gesicht",
   "kapitel": 2,
   "start": 16.52,
   "dauer": 3.302,
   "emotion": "erzaehlend",
   "text": "“Broken hip. No big deal. Weeds don't die.”"
  },
  {
   "nr": 6,
   "typ": "gesicht",
   "kapitel": 2,
   "start": 19.822,
   "dauer": 4.574,
   "emotion": "traurig",
   "text": "And then you tell him everything. The money. The lies. Mia."
  },
  {
   "nr": 7,
   "typ": "gesicht",
   "kapitel": 2,
   "start": 24.396,
   "dauer": 4.598,
   "emotion": "erzaehlend",
   "text": "Grandpa listens without interrupting once. Nobody does that better than him."
  },
  {
   "nr": 8,
   "typ": "lebenszeit",
   "kapitel": 3,
   "start": 28.994,
   "dauer": 4.91,
   "emotion": "erzaehlend",
   "text": "For forty-one years, Grandpa played the same numbers every single Saturday."
  },
  {
   "nr": 9,
   "typ": "objekt",
   "kapitel": 3,
   "start": 33.904,
   "dauer": 6.806,
   "emotion": "erklaerend",
   "text": "They're not lucky numbers. They're birthdays. Grandma, Mom, Dad, Lina. And yours."
  },
  {
   "nr": 10,
   "typ": "gesicht",
   "kapitel": 3,
   "start": 40.71,
   "dauer": 3.518,
   "emotion": "erzaehlend",
   "text": "“I never wanted to win. I just wanted to think of you every week.”"
  },
  {
   "nr": 11,
   "typ": "esstisch",
   "kapitel": 3,
   "start": 44.228,
   "dauer": 4.574,
   "emotion": "erzaehlend",
   "text": "Every Sunday, the whole family sat at his table. Until everyone got too busy."
  },
  {
   "nr": 12,
   "typ": "landschaft",
   "kapitel": 3,
   "start": 48.802,
   "dauer": 1.982,
   "emotion": "erzaehlend",
   "text": "The last time was eight months ago."
  },
  {
   "nr": 13,
   "typ": "gesicht",
   "kapitel": 3,
   "start": 50.784,
   "dauer": 1.55,
   "emotion": "traurig",
   "text": "And you didn't show up either."
  },
  {
   "nr": 14,
   "typ": "gesicht",
   "kapitel": 4,
   "start": 52.334,
   "dauer": 3.23,
   "emotion": "froh",
   "text": "“I wrote for all of us. Not for each of us.”"
  },
  {
   "nr": 15,
   "typ": "gesicht",
   "kapitel": 4,
   "start": 55.564,
   "dauer": 2.654,
   "emotion": "erzaehlend",
   "text": "You don't quite get what he means. Not yet."
  },
  {
   "nr": 16,
   "typ": "esstisch",
   "kapitel": 4,
   "start": 58.218,
   "dauer": 3.326,
   "emotion": "erzaehlend",
   "text": "You think about his dinner table. About the empty chairs."
  },
  {
   "nr": 17,
   "typ": "polarlicht",
   "kapitel": 4,
   "start": 61.544,
   "dauer": 2.846,
   "emotion": "erzaehlend",
   "text": "Outside, the sky is slowly getting light."
  },
  {
   "nr": 18,
   "typ": "gesicht",
   "kapitel": 5,
   "start": 64.39,
   "dauer": 2.87,
   "emotion": "ernst",
   "text": "“But first, you go see Mia. Today.”"
  },
  {
   "nr": 19,
   "typ": "grossstadt",
   "kapitel": 5,
   "start": 67.26,
   "dauer": 4.406,
   "emotion": "erzaehlend",
   "text": "So you run. Like a penguin with a backpack. Straight to Mia."
  }
 ]
}