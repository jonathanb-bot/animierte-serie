{
 "dauer": 72.036,
 "einstellungen": [
  {
   "nr": 1,
   "typ": "bahnhof",
   "kapitel": 1,
   "start": 0.0,
   "dauer": 3.542,
   "emotion": "erzaehlend",
   "text": "Your best friend let her train leave without her. For you."
  },
  {
   "nr": 2,
   "typ": "gesicht",
   "kapitel": 1,
   "start": 3.542,
   "dauer": 2.75,
   "emotion": "ernst",
   "text": "“I don't care about the money. I care about the lie.”"
  },
  {
   "nr": 3,
   "typ": "gesicht",
   "kapitel": 1,
   "start": 6.292,
   "dauer": 2.726,
   "emotion": "traurig",
   "text": "“I know. I was scared everything would change.”"
  },
  {
   "nr": 4,
   "typ": "grossstadt",
   "kapitel": 2,
   "start": 9.018,
   "dauer": 4.262,
   "emotion": "erzaehlend",
   "text": "You walk home together. Mia pulls her suitcase, you carry her bag."
  },
  {
   "nr": 5,
   "typ": "gesicht",
   "kapitel": 2,
   "start": 13.28,
   "dauer": 3.59,
   "emotion": "froh",
   "text": "“Well, it did. You've gotten really bad at lying.”"
  },
  {
   "nr": 6,
   "typ": "see",
   "kapitel": 2,
   "start": 16.87,
   "dauer": 4.502,
   "emotion": "erzaehlend",
   "text": "At the lake, she skips a stone. Five times. Yours sinks again."
  },
  {
   "nr": 7,
   "typ": "esstisch",
   "kapitel": 3,
   "start": 21.372,
   "dauer": 7.958,
   "emotion": "erzaehlend",
   "text": "Sunday. Grandpa's birthday. He's at the head of the table with his crutches. And for the first time in eight months, every chair is taken."
  },
  {
   "nr": 8,
   "typ": "gesicht",
   "kapitel": 3,
   "start": 29.33,
   "dauer": 4.094,
   "emotion": "ernst",
   "text": "You stand up. Your heart is pounding harder than at the lottery office."
  },
  {
   "nr": 9,
   "typ": "objekt",
   "kapitel": 3,
   "start": 33.424,
   "dauer": 2.462,
   "emotion": "erklaerend",
   "text": "“Grandpa won. With your birthdays.”"
  },
  {
   "nr": 10,
   "typ": "gesicht",
   "kapitel": 3,
   "start": 35.886,
   "dauer": 2.966,
   "emotion": "spannend",
   "text": "Dad drops his fork. Grandma chokes on her cake."
  },
  {
   "nr": 11,
   "typ": "gesicht",
   "kapitel": 3,
   "start": 38.852,
   "dauer": 2.174,
   "emotion": "froh",
   "text": "“So do I get a pony now?”"
  },
  {
   "nr": 12,
   "typ": "gesicht",
   "kapitel": 3,
   "start": 41.026,
   "dauer": 2.918,
   "emotion": "froh",
   "text": "Grandpa doesn't say a word. He just winks at you."
  },
  {
   "nr": 13,
   "typ": "esstisch",
   "kapitel": 4,
   "start": 43.944,
   "dauer": 6.23,
   "emotion": "froh",
   "text": "You split it. For all of us, just like the ticket said. And Grandpa wants only one thing in return."
  },
  {
   "nr": 14,
   "typ": "gesicht",
   "kapitel": 4,
   "start": 50.174,
   "dauer": 4.262,
   "emotion": "froh",
   "text": "“Every Sunday. Here. Everyone. No excuses.”"
  },
  {
   "nr": 15,
   "typ": "gesicht",
   "kapitel": 4,
   "start": 54.436,
   "dauer": 1.43,
   "emotion": "froh",
   "text": "Best deal of your life."
  },
  {
   "nr": 16,
   "typ": "lebenszeit",
   "kapitel": 4,
   "start": 55.866,
   "dauer": 5.174,
   "emotion": "erzaehlend",
   "text": "If all goes well, that's still a few hundred Sundays. Each one worth more than the jackpot."
  },
  {
   "nr": 17,
   "typ": "polarlicht",
   "kapitel": 5,
   "start": 61.04,
   "dauer": 3.926,
   "emotion": "erzaehlend",
   "text": "Later, you stand at the window with Mia. The city is glowing."
  },
  {
   "nr": 18,
   "typ": "kiosk",
   "kapitel": 5,
   "start": 64.966,
   "dauer": 7.07,
   "emotion": "froh",
   "text": "And on Saturday, Grandpa limps to the kiosk. Same numbers. Like always. Because he never played to win."
  }
 ]
}