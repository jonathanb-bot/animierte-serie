{
 "dauer": 229.106,
 "einstellungen": [
  {
   "nr": 1,
   "typ": "skyline",
   "kapitel": 1,
   "start": 0.0,
   "dauer": 4.5,
   "emotion": "erzaehlend",
   "text": "Stell dir vor, die *Zombie-Apokalypse* bricht aus."
  },
  {
   "nr": 2,
   "typ": "hochhaus",
   "kapitel": 1,
   "start": 4.5,
   "dauer": 4.862,
   "emotion": "erzaehlend",
   "text": "Und du wohnst ganz oben. Im *24. Stock* eines Hochhauses."
  },
  {
   "nr": 3,
   "typ": "hochhaus",
   "kapitel": 1,
   "start": 9.362,
   "dauer": 3.854,
   "emotion": "erzaehlend",
   "text": "Unter dir: dreiundzwanzig Etagen. Und ganz unten: *sie*."
  },
  {
   "nr": 4,
   "typ": "gesicht",
   "kapitel": 1,
   "start": 13.216,
   "dauer": 3.254,
   "emotion": "spannend",
   "text": "Die Frage ist nicht, ob sie kommen. Sondern *wann*."
  },
  {
   "nr": 5,
   "typ": "titel",
   "kapitel": 1,
   "start": 16.47,
   "dauer": 3.2,
   "emotion": null,
   "text": ""
  },
  {
   "nr": 6,
   "typ": "skyline",
   "kapitel": 2,
   "start": 19.67,
   "dauer": 3.854,
   "emotion": "erzaehlend",
   "text": "Dienstag, sieben Uhr vierzig. Die Sonne geht über der Stadt auf."
  },
  {
   "nr": 7,
   "typ": "wohnung",
   "kapitel": 2,
   "start": 23.524,
   "dauer": 4.334,
   "emotion": "froh",
   "text": "Du stehst in deiner Küche im obersten Stock. Kaffee, Handy, alles wie immer."
  },
  {
   "nr": 8,
   "typ": "wohnung",
   "kapitel": 2,
   "start": 27.858,
   "dauer": 4.334,
   "emotion": "ernst",
   "text": "Dann vibriert dein Handy. Einmal. Zweimal. *Zwanzigmal*."
  },
  {
   "nr": 9,
   "typ": "gesicht",
   "kapitel": 2,
   "start": 32.192,
   "dauer": 4.286,
   "emotion": "ernst",
   "text": "Eilmeldung: Unruhen in der Innenstadt. Menschen greifen andere Menschen an."
  },
  {
   "nr": 10,
   "typ": "objekt",
   "kapitel": 2,
   "start": 36.478,
   "dauer": 3.902,
   "emotion": "erklaerend",
   "text": "Bleiben Sie in Ihren Wohnungen. Halten Sie Türen und Fenster *geschlossen*."
  },
  {
   "nr": 11,
   "typ": "gesicht",
   "kapitel": 2,
   "start": 40.38,
   "dauer": 2.27,
   "emotion": "ernst",
   "text": "Du denkst: Das ist bestimmt übertrieben."
  },
  {
   "nr": 12,
   "typ": "wohnung",
   "kapitel": 2,
   "start": 42.65,
   "dauer": 1.814,
   "emotion": "spannend",
   "text": "Bis du aus dem Fenster schaust."
  },
  {
   "nr": 13,
   "typ": "strasse",
   "kapitel": 3,
   "start": 44.464,
   "dauer": 3.518,
   "emotion": "erzaehlend",
   "text": "Unten auf der Straße rennen Leute. Aber nicht alle rennen *weg*."
  },
  {
   "nr": 14,
   "typ": "strasse",
   "kapitel": 3,
   "start": 47.982,
   "dauer": 4.31,
   "emotion": "erzaehlend",
   "text": "Manche rennen *hinterher*. Sie bewegen sich komisch. Ruckartig."
  },
  {
   "nr": 15,
   "typ": "strasse",
   "kapitel": 3,
   "start": 52.292,
   "dauer": 2.126,
   "emotion": "erzaehlend",
   "text": "Dann geht eine *Autoalarmanlage* los."
  },
  {
   "nr": 16,
   "typ": "strasse",
   "kapitel": 3,
   "start": 54.418,
   "dauer": 4.07,
   "emotion": "erzaehlend",
   "text": "Und plötzlich drehen sich alle gleichzeitig um. Und laufen genau dorthin."
  },
  {
   "nr": 17,
   "typ": "gesicht",
   "kapitel": 3,
   "start": 58.488,
   "dauer": 3.23,
   "emotion": "spannend",
   "text": "Da merkst du dir die erste Regel: Sie reagieren auf *Lärm*."
  },
  {
   "nr": 18,
   "typ": "objekt",
   "kapitel": 3,
   "start": 61.718,
   "dauer": 3.662,
   "emotion": "erklaerend",
   "text": "Alles, was laut ist, lockt sie an. Und Hochhäuser *hallen*."
  },
  {
   "nr": 19,
   "typ": "hochhaus",
   "kapitel": 4,
   "start": 65.38,
   "dauer": 3.038,
   "emotion": "erzaehlend",
   "text": "Jetzt musst du entscheiden. Fliehen oder bleiben?"
  },
  {
   "nr": 20,
   "typ": "hochhaus",
   "kapitel": 4,
   "start": 68.418,
   "dauer": 5.198,
   "emotion": "erzaehlend",
   "text": "Fliehen heißt: vierundzwanzig Stockwerke runter. Durch ein Treppenhaus, das du nicht kennst."
  },
  {
   "nr": 21,
   "typ": "strasse",
   "kapitel": 4,
   "start": 73.616,
   "dauer": 2.678,
   "emotion": "erzaehlend",
   "text": "Und unten durch genau die Straße, in der *sie* sind."
  },
  {
   "nr": 22,
   "typ": "skyline",
   "kapitel": 4,
   "start": 76.294,
   "dauer": 4.118,
   "emotion": "erzaehlend",
   "text": "Oben bleiben heißt: Du bist weit weg von allem. Sie müssen *zu dir* hoch."
  },
  {
   "nr": 23,
   "typ": "treppenhaus",
   "kapitel": 4,
   "start": 80.412,
   "dauer": 4.646,
   "emotion": "erzaehlend",
   "text": "Und es gibt nur einen Weg zu dir: das *Treppenhaus*. Den Aufzug kannst du vergessen."
  },
  {
   "nr": 24,
   "typ": "gesicht",
   "kapitel": 4,
   "start": 85.058,
   "dauer": 2.366,
   "emotion": "ernst",
   "text": "Du entscheidest dich. Du *bleibst*."
  },
  {
   "nr": 25,
   "typ": "gesicht",
   "kapitel": 5,
   "start": 87.424,
   "dauer": 3.11,
   "emotion": "ernst",
   "text": "Und dann fällt dir etwas ein, woran fast niemand denkt."
  },
  {
   "nr": 26,
   "typ": "hochhaus",
   "kapitel": 5,
   "start": 90.534,
   "dauer": 5.678,
   "emotion": "erzaehlend",
   "text": "Wasser kommt nicht von allein in den 24. Stock. Es wird von *Pumpen* hochgedrückt."
  },
  {
   "nr": 27,
   "typ": "objekt",
   "kapitel": 5,
   "start": 96.212,
   "dauer": 4.838,
   "emotion": "erklaerend",
   "text": "Und Pumpen brauchen *Strom*. Fällt der Strom aus, fällt zuerst das Wasser ganz oben aus."
  },
  {
   "nr": 28,
   "typ": "hochhaus",
   "kapitel": 5,
   "start": 101.05,
   "dauer": 4.358,
   "emotion": "erzaehlend",
   "text": "Die unteren Etagen haben vielleicht noch Wasser. Du ganz oben: *nichts mehr*."
  },
  {
   "nr": 29,
   "typ": "gesicht",
   "kapitel": 5,
   "start": 105.408,
   "dauer": 1.622,
   "emotion": "spannend",
   "text": "Also rennst du ins Bad."
  },
  {
   "nr": 30,
   "typ": "bad",
   "kapitel": 5,
   "start": 107.03,
   "dauer": 3.758,
   "emotion": "erzaehlend",
   "text": "Stöpsel rein, Wasserhahn *voll auf*. Die Badewanne läuft voll."
  },
  {
   "nr": 31,
   "typ": "wohnung",
   "kapitel": 5,
   "start": 110.788,
   "dauer": 4.43,
   "emotion": "erzaehlend",
   "text": "Dann jeder Topf. Jede Flasche. Jeder Eimer, den du findest."
  },
  {
   "nr": 32,
   "typ": "objekt",
   "kapitel": 5,
   "start": 115.218,
   "dauer": 2.75,
   "emotion": "erklaerend",
   "text": "Alles, was Wasser halten kann, wird *gefüllt*."
  },
  {
   "nr": 33,
   "typ": "bad",
   "kapitel": 5,
   "start": 117.968,
   "dauer": 4.022,
   "emotion": "froh",
   "text": "Die Badewanne fasst über hundert Liter. Das kann über Leben und Tod *entscheiden*."
  },
  {
   "nr": 34,
   "typ": "wohnung",
   "kapitel": 6,
   "start": 121.99,
   "dauer": 2.222,
   "emotion": "erzaehlend",
   "text": "Danach machst du eine Bestandsaufnahme."
  },
  {
   "nr": 35,
   "typ": "objekt",
   "kapitel": 6,
   "start": 124.212,
   "dauer": 5.654,
   "emotion": "erklaerend",
   "text": "Essen für ungefähr sechs Tage. Eine Taschenlampe. Eine Powerbank. Vier Kerzen."
  },
  {
   "nr": 36,
   "typ": "gesicht",
   "kapitel": 6,
   "start": 129.866,
   "dauer": 2.582,
   "emotion": "ernst",
   "text": "Nicht viel. Aber mehr als die meisten."
  },
  {
   "nr": 37,
   "typ": "wohnung",
   "kapitel": 6,
   "start": 132.448,
   "dauer": 5.63,
   "emotion": "erzaehlend",
   "text": "Und du machst *alles* aus. Fernseher. Musik. Sogar den Kühlschrank hörst du jetzt brummen."
  },
  {
   "nr": 38,
   "typ": "treppenhaus",
   "kapitel": 7,
   "start": 138.078,
   "dauer": 3.0,
   "emotion": "erzaehlend",
   "text": "Am Nachmittag: *Klopfen*. Leise. Dreimal."
  },
  {
   "nr": 39,
   "typ": "gesicht",
   "kapitel": 7,
   "start": 141.078,
   "dauer": 1.526,
   "emotion": "spannend",
   "text": "Du hältst den Atem an."
  },
  {
   "nr": 40,
   "typ": "treppenhaus",
   "kapitel": 7,
   "start": 142.604,
   "dauer": 4.094,
   "emotion": "erzaehlend",
   "text": "Durch den Spion siehst du einen alten Mann. Er hält einen Finger vor den Mund."
  },
  {
   "nr": 41,
   "typ": "gesicht",
   "kapitel": 7,
   "start": 146.698,
   "dauer": 4.646,
   "emotion": "ernst",
   "text": "„Ich bin Walter. Dreißig Jahre Hausmeister hier. Lass mich rein, Junge.“"
  },
  {
   "nr": 42,
   "typ": "wohnung",
   "kapitel": 7,
   "start": 151.344,
   "dauer": 2.606,
   "emotion": "erzaehlend",
   "text": "Walter kennt dieses Haus *besser* als jeder andere."
  },
  {
   "nr": 43,
   "typ": "gesicht",
   "kapitel": 7,
   "start": 153.95,
   "dauer": 6.71,
   "emotion": "ernst",
   "text": "„Hast du Wasser gesammelt? Gut. Heute Abend fällt der Strom aus. Die Notstromaggregate halten nicht lange.“"
  },
  {
   "nr": 44,
   "typ": "gesicht",
   "kapitel": 7,
   "start": 160.66,
   "dauer": 4.07,
   "emotion": "wuetend",
   "text": "„Und benutz nie den Aufzug. Wenn der stecken bleibt, bist du in einer *Kiste*.“"
  },
  {
   "nr": 45,
   "typ": "hochhaus",
   "kapitel": 7,
   "start": 164.73,
   "dauer": 4.478,
   "emotion": "erzaehlend",
   "text": "Ein Aufzug ohne Strom ist eine Falle. Mit offenen Türen in jeder Etage."
  },
  {
   "nr": 46,
   "typ": "skyline",
   "kapitel": 8,
   "start": 169.208,
   "dauer": 3.254,
   "emotion": "erzaehlend",
   "text": "Am Abend sitzt ihr am Fenster und seht zu, wie die Stadt *stirbt*."
  },
  {
   "nr": 47,
   "typ": "wohnung",
   "kapitel": 8,
   "start": 172.462,
   "dauer": 3.71,
   "emotion": "erzaehlend",
   "text": "Überall Rauch. Sirenen, die eine nach der anderen verstummen."
  },
  {
   "nr": 48,
   "typ": "skyline",
   "kapitel": 8,
   "start": 176.172,
   "dauer": 3.638,
   "emotion": "erzaehlend",
   "text": "Dann gehen die ersten Lichter aus. Ganze Viertel werden *schwarz*."
  },
  {
   "nr": 49,
   "typ": "gesicht",
   "kapitel": 8,
   "start": 179.81,
   "dauer": 4.142,
   "emotion": "ernst",
   "text": "„Siehst du die Fenster, die noch leuchten? Die sieht man kilometerweit.“"
  },
  {
   "nr": 50,
   "typ": "skyline",
   "kapitel": 8,
   "start": 183.952,
   "dauer": 1.742,
   "emotion": "erzaehlend",
   "text": "Und nicht nur Menschen sehen sie."
  },
  {
   "nr": 51,
   "typ": "objekt",
   "kapitel": 8,
   "start": 185.694,
   "dauer": 3.662,
   "emotion": "erklaerend",
   "text": "Zweite Regel: Licht verrät dich. Nachts bleibt es *dunkel*."
  },
  {
   "nr": 52,
   "typ": "wohnung",
   "kapitel": 9,
   "start": 189.356,
   "dauer": 2.342,
   "emotion": "erzaehlend",
   "text": "Um zweiundzwanzig Uhr dreizehn passiert es."
  },
  {
   "nr": 53,
   "typ": "wohnung",
   "kapitel": 9,
   "start": 191.698,
   "dauer": 2.198,
   "emotion": "spannend",
   "text": "*Klack.* Der Strom ist weg."
  },
  {
   "nr": 54,
   "typ": "bad",
   "kapitel": 9,
   "start": 193.896,
   "dauer": 5.63,
   "emotion": "erzaehlend",
   "text": "Du rennst ins Bad und drehst den Hahn auf. Ein Gurgeln. Ein paar Tropfen. Dann *nichts*."
  },
  {
   "nr": 55,
   "typ": "hochhaus",
   "kapitel": 9,
   "start": 199.526,
   "dauer": 4.766,
   "emotion": "erzaehlend",
   "text": "Die Pumpen stehen still. Und das Wasser im 24. Stock ist *weg*."
  },
  {
   "nr": 56,
   "typ": "gesicht",
   "kapitel": 9,
   "start": 204.292,
   "dauer": 3.23,
   "emotion": "froh",
   "text": "Walter grinst. „Gut, dass du die Wanne gefüllt hast.“"
  },
  {
   "nr": 57,
   "typ": "wohnung",
   "kapitel": 10,
   "start": 207.522,
   "dauer": 3.038,
   "emotion": "erzaehlend",
   "text": "Kurz vor Mitternacht. Ihr wollt gerade schlafen."
  },
  {
   "nr": 58,
   "typ": "treppenhaus",
   "kapitel": 10,
   "start": 210.56,
   "dauer": 3.182,
   "emotion": "erzaehlend",
   "text": "Da hört ihr Schritte im Treppenhaus. *Schnelle* Schritte."
  },
  {
   "nr": 59,
   "typ": "gesicht",
   "kapitel": 10,
   "start": 213.742,
   "dauer": 2.87,
   "emotion": "spannend",
   "text": "Sie kommen näher. Etage für Etage."
  },
  {
   "nr": 60,
   "typ": "hochhaus",
   "kapitel": 10,
   "start": 216.612,
   "dauer": 3.878,
   "emotion": "erzaehlend",
   "text": "Zweiundzwanzig. Dreiundzwanzig. *Vierundzwanzig*."
  },
  {
   "nr": 61,
   "typ": "treppenhaus",
   "kapitel": 10,
   "start": 220.49,
   "dauer": 2.222,
   "emotion": "erzaehlend",
   "text": "Dann: Jemand hämmert gegen deine Tür."
  },
  {
   "nr": 62,
   "typ": "gesicht",
   "kapitel": 10,
   "start": 222.712,
   "dauer": 2.894,
   "emotion": "spannend",
   "text": "Und du weißt nicht, ob da draußen noch ein *Mensch* steht."
  },
  {
   "nr": 63,
   "typ": "titel",
   "kapitel": 10,
   "start": 225.606,
   "dauer": 3.5,
   "emotion": null,
   "text": ""
  }
 ]
}