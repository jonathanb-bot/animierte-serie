  {
   "nr": 18,
   "typ": "wohnung",
   "kapitel": 4,
   "start": 57.72,
   "dauer": 3.878,
   "emotion": "erzaehlend",
   "text": "Es ist Tag. Also prüfst du am Fenster deine Frisur."
  },
  {
