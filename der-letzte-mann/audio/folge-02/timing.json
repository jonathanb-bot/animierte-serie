{
 "dauer": 92.844,
 "einstellungen": [
  {
   "nr": 1,
   "typ": "spion",
   "kapitel": 1,
   "start": 0.0,
   "dauer": 3.086,
   "emotion": "ernst",
   "text": "Stell dir vor, jemand weiß, dass du *noch* da bist."
  },
  {
   "nr": 2,
   "typ": "tuer",
   "kapitel": 1,
   "start": 3.086,
   "dauer": 2.774,
   "emotion": "erzaehlend",
   "text": "Deine Nachbarin Lea schiebt sich einfach an dir vorbei."
  },
  {
   "nr": 3,
   "typ": "wohnung",
   "kapitel": 1,
   "start": 5.86,
   "dauer": 3.854,
   "emotion": "erzaehlend",
   "text": "Als Erstes zieht sie deinen Vorhang zu. „Bleib vom Fenster weg.“"
