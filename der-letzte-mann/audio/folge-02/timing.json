  },
  {
   "nr": 20,
   "typ": "wohnung",
   "kapitel": 5,
   "start": 63.748,
   "dauer": 3.014,
   "emotion": "erzaehlend",
   "text": "Als Lea zurückkommt, stehst du immer noch am Fenster."
