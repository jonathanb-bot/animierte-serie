  },
  {
   "nr": 14,
   "typ": "tokio",
   "kapitel": 4,
   "start": 51.232,
   "dauer": 4.19,
   "emotion": "erzaehlend",
   "text": "In Tokio ist Morgen. Menschen halten Fotos hoch."
