  {
   "nr": 18,
   "typ": "keller",
   "kapitel": 4,
   "start": 67.488,
   "dauer": 3.134,
   "emotion": "erzaehlend",
   "text": "Wer war es dann? Das dritte Lämpchen leuchtet noch."
