  {
   "nr": 12,
   "typ": "gesicht",
   "kapitel": 3,
   "start": 43.572,
   "dauer": 4.286,
   "emotion": "ruhig",
   "text": "Die Stimme kennst du: Hörstudie. Du, mit Kaffee auf der Hose."
  },
  {
   "nr": 13,
   "typ": "gesicht",
   "kapitel": 3,
   "start": 47.858,
   "dauer": 3.374,
   "emotion": "spannend",
