   "typ": "gesicht",
   "kapitel": 4,
   "start": 58.172,
   "dauer": 4.31,
   "emotion": "erzaehlend",
   "text": "„1:13 Uhr. Beide an die Kellertür. Auf drei drücken wir die Klinke.“"
  },
  {
   "nr": 17,
   "typ": "gesicht",
   "kapitel": 4,
   "start": 62.482,
   "dauer": 5.006,
   "emotion": "ernst",
   "text": "„Warst du um 22:58 an der Tür?“ „Nein“, sagt Nika. „Da war ich *oben*.“"
