  {
   "nr": 11,
   "typ": "objekt",
   "kapitel": 3,
   "start": 36.694,
   "dauer": 6.878,
   "emotion": "erklaerend",
   "text": "Echter Fakt: Alte Telefone übertragen nur 300 bis 3400 Hertz. Stimmen klingen dünn."
