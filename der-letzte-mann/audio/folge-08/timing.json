   "kapitel": 1,
   "start": 0.0,
   "dauer": 4.766,
   "emotion": "erzaehlend",
   "text": "Stell dir vor, die Frau hinter allem steht plötzlich vor dir."
  },
  {
   "nr": 2,
   "typ": "keller",
   "kapitel": 1,
   "start": 4.766,
   "dauer": 4.43,
   "emotion": "erzaehlend",
   "text": "Gerade piept noch die Konsole: „Neues Muster gespeichert: T.“"
  },
  {
   "nr": 3,
   "typ": "keller",
   "kapitel": 1,
   "start": 9.196,
   "dauer": 3.302,
   "emotion": "erzaehlend",
   "text": "Doktor Eva Winter. Mantel. Tablet."
  },
  {
   "nr": 4,
   "typ": "gesicht",
   "kapitel": 1,
   "start": 12.498,
   "dauer": 3.446,
   "emotion": "froh",
   "text": "„Herr Brandt. Sie haben S7 geweckt.“"
  },
  {
   "nr": 5,
   "typ": "gesicht",
   "kapitel": 1,
   "start": 15.944,
   "dauer": 3.11,
   "emotion": "erzaehlend",
   "text": "Lea stellt sich zwischen euch. Freundlich ist anders."
  },
  {
   "nr": 6,
   "typ": "gesicht",
   "kapitel": 1,
   "start": 19.054,
   "dauer": 2.558,
   "emotion": "erzaehlend",
   "text": "Du ziehst den Bauch ein. *Schon* wieder."
  },
  {
   "nr": 7,
   "typ": "titel",
   "kapitel": 1,
   "start": 21.612,
   "dauer": 1.0,
   "emotion": null,
   "text": ""
  },
  {
   "nr": 8,
   "typ": "keller",
   "kapitel": 2,
   "start": 22.612,
   "dauer": 4.094,
   "emotion": "erzaehlend",
   "text": "Unter deinem Haus steht die Konsole von Projekt Spiegel."
  },
  {
   "nr": 9,
   "typ": "skyline",
   "kapitel": 2,
   "start": 26.706,
   "dauer": 2.582,
   "emotion": "erzaehlend",
   "text": "Alle Männer sind verschwunden. Nur du nicht."
  },
  {
   "nr": 10,
   "typ": "keller",
   "kapitel": 2,
   "start": 29.288,
   "dauer": 2.87,
   "emotion": "erzaehlend",
   "text": "Über ein Telefon im Keller hast du deinen Vater erreicht."
  },
  {
   "nr": 11,
   "typ": "gesicht",
   "kapitel": 2,
   "start": 32.158,
   "dauer": 3.374,
   "emotion": "erzaehlend",
   "text": "Bei ihm sind alle Frauen weg. Bis auf eine."
  },
  {
   "nr": 12,
   "typ": "gesicht",
   "kapitel": 3,
   "start": 35.532,
   "dauer": 2.846,
   "emotion": "erzaehlend",
   "text": "„Wir wollten die Welt kurz spiegeln. Zum Messen.“"
  },
  {
   "nr": 13,
   "typ": "objekt",
   "kapitel": 3,
   "start": 38.378,
   "dauer": 5.63,
   "emotion": "erklaerend",
   "text": "GPS-Uhren gehen wegen der Relativität täglich 38 Mikrosekunden vor."
  },
  {
   "nr": 14,
   "typ": "objekt",
   "kapitel": 3,
   "start": 44.008,
   "dauer": 3.686,
   "emotion": "erklaerend",
   "text": "Unkorrigiert wäre GPS pro Tag zehn Kilometer daneben."
  },
  {
   "nr": 15,
   "typ": "gesicht",
   "kapitel": 3,
   "start": 47.694,
   "dauer": 3.494,
   "emotion": "ernst",
   "text": "„Um 8:13 wurde daraus eine zweite *Welt*.“"
  },
  {
   "nr": 16,
   "typ": "gesicht",
   "kapitel": 3,
   "start": 51.188,
   "dauer": 5.174,
   "emotion": "spannend",
   "text": "Zwei Welten. Hier die Frauen. Drüben die Männer. Und Papa."
  },
  {
   "nr": 17,
   "typ": "newyork",
   "kapitel": 4,
   "start": 56.362,
   "dauer": 6.134,
   "emotion": "erzaehlend",
   "text": "In New York flackerten um 15:13 wieder alle Bildschirme. Niemand weiß, warum."
  },
  {
   "nr": 18,
   "typ": "gesicht",
   "kapitel": 4,
   "start": 62.496,
   "dauer": 4.934,
   "emotion": "erzaehlend",
   "text": "„Jede Seite braucht einen Anker“, sagt Winter. „Dich. Aus der Hörstudie.“"
  },
  {
   "nr": 19,
   "typ": "keller",
   "kapitel": 4,
   "start": 67.43,
   "dauer": 4.55,
   "emotion": "erzaehlend",
   "text": "„Das dritte Lämpchen zeigt gespeicherte Muster an dieser Tür. Auf *beiden* Seiten.“"
  },
  {
   "nr": 20,
   "typ": "keller",
   "kapitel": 4,
   "start": 71.98,
   "dauer": 5.558,
   "emotion": "erzaehlend",
   "text": "„Ein Anker hält eine Seite. Zwei Anker an derselben Schwelle halten eine *Tür*.“"
  },
  {
   "nr": 21,
   "typ": "gesicht",
   "kapitel": 4,
   "start": 77.538,
   "dauer": 3.59,
   "emotion": "ernst",
   "text": "„Ohne Kontrolle verschiebt so eine Tür Menschen. Auch Lea.“"
  },
  {
   "nr": 22,
   "typ": "keller",
   "kapitel": 5,
   "start": 81.128,
   "dauer": 3.614,
   "emotion": "erzaehlend",
   "text": "Winter sperrt die Konsole. „Morgen um acht schalte ich ab.“"
  },
  {
   "nr": 23,
   "typ": "gesicht",
   "kapitel": 5,
   "start": 84.742,
   "dauer": 4.19,
   "emotion": "erzaehlend",
   "text": "„Lassen Sie die Sicherung aus. Ohne Netzstrom: nur zehn Sekunden.“"
  },
  {
   "nr": 24,
   "typ": "handy",
   "kapitel": 5,
   "start": 88.932,
   "dauer": 3.566,
   "emotion": "erzaehlend",
   "text": "Auf ihrem Tablet blinkt ein Protokoll. Lea schnappt es sich."
  },
  {
   "nr": 25,
   "typ": "handy",
   "kapitel": 5,
   "start": 92.498,
   "dauer": 4.142,
   "emotion": "erzaehlend",
   "text": "„Anker B. Seite B. Wählversuche: 31.“"
  },
  {
   "nr": 26,
   "typ": "gesicht",
   "kapitel": 5,
   "start": 96.64,
   "dauer": 3.014,
   "emotion": "spannend",
   "text": "Die zweite Ausnahme sucht *dich*. Seit gestern."
  },
  {
   "nr": 27,
   "typ": "titel",
   "kapitel": 5,
   "start": 99.654,
   "dauer": 1.0,
