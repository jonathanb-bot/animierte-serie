{"start": 13.8, "ende": 29.15, "beat": 0.4511, "beat0": 0.4281, "takt0": -13.556, "zeilen": [{"text": "Lieber Gott, mach mich bitte niemals arm", "woerter": [{"w": "Lieber", "a": 0.203}, {"w": "Gott,", "a": 0.992}, {"w": "mach", "a": 1.556}, {"w": "mich", "a": 1.606}, {"w": "bitte", "a": 1.781}, {"w": "niemals", "a": 2.233}, {"w": "arm", "a": 2.796}], "a": 0.143, "e": 3.526}, {"text": "Denn ich zahl' meine Schulden mit Harām", "woerter": [{"w": "Denn", "a": 3.586}, {"w": "ich", "a": 4.262}, {"w": "zahl'", "a": 4.601}, {"w": "meine", "a": 5.277}, {"w": "Schulden", "a": 5.327}, {"w": "mit", "a": 5.841}, {"w": "Harām", "a": 6.405}], "a": 3.526, "e": 6.909}, {"text": "Alles was ich sehe ist alles was er plant", "woerter": [{"w": "Alles", "a": 6.969}, {"w": "was", "a": 7.646}, {"w": "ich", "a": 7.871}, {"w": "sehe", "a": 8.21}, {"w": "ist", "a": 8.548}, {"w": "alles", "a": 8.886}, {"w": "was", "a": 9.45}, {"w": "er", "a": 9.676}, {"w": "plant", "a": 10.014}], "a": 6.909, "e": 10.405}, {"text": "Trotzdem richte ich meinen Blick to the sky", "woerter": [{"w": "Trotzdem", "a": 10.465}, {"w": "richte", "a": 11.254}, {"w": "ich", "a": 11.818}, {"w": "meinen", "a": 12.157}, {"w": "Blick", "a": 12.495}, {"w": "to", "a": 12.833}, {"w": "the", "a": 13.172}, {"w": "sky", "a": 13.51}], "a": 10.405, "e": 13.901}, {"text": "Der Teufel will mein' Seele, erteilt mir Befehle", "woerter": [{"w": "Der", "a": 13.961}, {"w": "Teufel", "a": 14.412}, {"w": "will", "a": 14.863}, {"w": "mein'", "a": 15.089}, {"w": "Seele,", "a": 15.653}, {"w": "erteilt", "a": 16.217}, {"w": "mir", "a": 16.668}, {"w": "Befehle", "a": 16.893}], "a": 13.901, "e": 17.735}, {"text": "Flaschen platzen, Schlampen tanzen, auf dem Tisch Verträge", "woerter": [{"w": "Flaschen", "a": 17.795}, {"w": "platzen,", "a": 18.472}, {"w": "Schlampen", "a": 18.923}, {"w": "tanzen,", "a": 19.374}, {"w": "auf", "a": 19.825}, {"w": "dem", "a": 20.051}, {"w": "Tisch", "a": 20.277}, {"w": "Verträge", "a": 20.502}], "a": 17.735, "e": 21.